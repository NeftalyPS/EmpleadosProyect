@model List<Departamento>
@{
    ViewData["Title"] = "Departamentos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Departamentos</h3>
    @if (User.IsInRole("Admin") || User.IsInRole("RRHH"))
    {
        <a asp-action="Create" class="btn btn-success">+ Nuevo departamento</a>
    }
</div>
<table class="table table-striped">
    <thead><tr><th>Nombre</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.Nombre</td>
                <td>
                    @if (User.IsInRole("Admin") || User.IsInRole("RRHH"))
                    {
                        <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-warning">Editar</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar este departamento?');">
                            <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>