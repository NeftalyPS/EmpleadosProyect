@model List<Empleado>
@{
    ViewData["Title"] = "Empleados";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Empleados</h3>
    <a asp-action="Create" class="btn btn-success">+ Nuevo empleado</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="nombre" value="@ViewBag.Nombre" class="form-control" placeholder="Nombre" />
    </div>
    <div class="col-auto">
        <input type="text" name="apellido" value="@ViewBag.Apellido" class="form-control" placeholder="Apellido" />
    </div>
    <div class="col-auto">
        <input type="date" name="fechaContratacion" value="@ViewBag.FechaContratacion" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Departamento</th>
            <th>Puesto</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(e.FotoRuta))
                    {
                        <img src="@e.FotoRuta" width="40" height="40" class="rounded-circle" />
                    }
                </td>
                <td>@e.Nombre</td>
                <td>@e.Apellido</td>
                <td>@e.Departamento?.Nombre</td>
                <td>@e.Puesto</td>
                <td>
                    <span class="badge bg-@(e.Estado == EstadoEmpleado.Activo ? "success" : e.Estado == EstadoEmpleado.Inactivo ? "secondary" : "danger")">
                        @e.Estado
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-info">Ver</a>
                    @if (e.Estado != EstadoEmpleado.Despedido)
                    {
                        <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-warning">Editar</a>
                        <form asp-action="Desactivar" asp-route-id="@e.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-secondary">@(e.Estado == EstadoEmpleado.Activo ? "Desactivar" : "Reactivar")</button>
                        </form>
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Despedir" asp-route-id="@e.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Despedir a este empleado? Esta acción es irreversible.');">
                                <button type="submit" class="btn btn-sm btn-danger">Despedir</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                <a class="page-link" href="?page=@i&nombre=@ViewBag.Nombre&apellido=@ViewBag.Apellido&fechaContratacion=@ViewBag.FechaContratacion">@i</a>
            </li>
        }
    </ul>
</nav>