@model Empleado
@{
    ViewData["Title"] = "Editar empleado";
}
<h3>Editar empleado</h3>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Apellido</label>
            <input asp-for="Apellido" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Departamento</label>
            <select asp-for="DepartamentoId" class="form-select">
                @foreach (var d in (List<Departamento>)ViewBag.Departamentos)
                {
                    <option value="@d.Id">@d.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Puesto</label>
            <input asp-for="Puesto" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Salario</label>
            <input asp-for="Salario" type="number" step="0.01" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Teléfono</label>
            <input asp-for="Telefono" class="form-control" />
        </div>
        <div class="col-md-12">
            <label class="form-label">Dirección</label>
            <input asp-for="Direccion" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Correo</label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Nueva fotografía (opcional)</label>
            <input type="file" name="foto" class="form-control" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancelar</a>
</form>